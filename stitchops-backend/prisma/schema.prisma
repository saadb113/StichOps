generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALESPERSON
  // Any non-Salesperson employee (Designer, or a custom team) who gets a
  // self-service login — same portal shape as Salesperson minus the
  // customer-facing bits (no "My Customers"), see routes/employees.js and
  // stitchops-react's Guards.jsx / Sidebar.jsx.
  EMPLOYEE
}

// Singleton row (id always 1) holding server-generated sequence numbers
// that the UI needs to preview before the record actually exists
// (e.g. "will be numbered INV-0232 on approval").
model Counter {
  id               Int @id @default(autoincrement())
  nextInvoiceNo    Int @default(232)
  nextCustomerCode Int @default(1005)
  // First-of-month date of the last period the monthly auto-invoice run
  // (lib/monthlyInvoicing.js) has already processed, so the reactive check
  // doesn't re-bundle the same month's orders on every notification load.
  lastAutoInvoiceRun DateTime? @db.Date
  // Same idea, for the "salary slips are ready" notification
  // (lib/monthlySlipNotify.js) — fires once per newly-closed month.
  lastSlipNotifyRun  DateTime? @db.Date
}

model Company {
  id              Int    @id @default(autoincrement())
  name            String
  address         String
  email           String @default("")
  contact         String @default("")
  defaultCurrency String @default("PKR")
  logo            String?
}

// Which fields are meaningful depends on `country` — e.g. sortCode/iban for
// the UK, routingNumber/accountType for the US, bic/iban for Europe,
// bsb/bic for Australia (see BANK_COUNTRIES in the frontend). Kept as a
// flat, sparse set of optional columns rather than per-country tables or a
// JSON blob, matching this schema's existing style (Customer/Order already
// carry plenty of optional fields the same way).
model BankAccount {
  id             Int    @id @default(autoincrement())
  country        String @default("United Kingdom")
  currency       String
  accountName    String @default("")
  accountHolder  String @default("")
  accountNo      String @default("")
  sortCode       String @default("")
  routingNumber  String @default("")
  accountType    String @default("")
  bic            String @default("")
  iban           String @default("")
  bsb            String @default("")
  paymentAccount String @default("")
  address        String @default("")

  createdAt DateTime @default(now())
}

model CurrencyRate {
  id       Int     @id @default(autoincrement())
  currency String  @unique
  rate     Float
  isCustom Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model EmployeeCategory {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Employee {
  id          Int     @id @default(autoincrement())
  name        String
  role        String
  designation String?
  currency    String
  baseSalary  Float
  payoutDay   Int
  email       String?
  contact     String?
  photo       String?
  commissionRate Float @default(10)

  // Salary slips are approved one calendar month at a time (see
  // lib/slipNumber.js and routes/employees.js' approve-slip) — slipPrefix/
  // nextSlipSeq number them like SHA-0010, SHA-0011 (first 3 letters of the
  // employee's name, not checked for collisions, same convention as the
  // customer invoice prefix). lastSlipApprovedPeriod is the first-of-month
  // date of the most recently approved period, so a closed month can't be
  // approved twice.
  slipPrefix             String?
  nextSlipSeq            Int      @default(1)
  lastSlipApprovedPeriod DateTime? @db.Date

  user                  User?
  companyEmails         CompanyEmail[]
  customers             Customer[]              @relation("CustomerSalesperson")
  designedOrders        Order[]                 @relation("OrderDesigner")
  payslips              Payslip[]
  passwordResetRequests PasswordResetRequest[]
  notifications         Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyEmail {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  passwordHash       String
  role               UserRole
  employeeId         Int?      @unique
  employee           Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  mustChangePassword Boolean   @default(false)
  welcomed           Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id            Int      @id @default(autoincrement())
  customerCode  String?  @unique
  name          String
  company       String
  country       String
  currency      String
  address       String   @default("")
  zip           String   @default("")
  email         String
  emailClient   String
  contact       String
  salespersonId Int
  salesperson   Employee @relation("CustomerSalesperson", fields: [salespersonId], references: [id])
  receivedEmail String?
  status        String   @default("Free Trial")
  invoiceDay    Int?
  notes         String   @default("")

  // Derived from company + contact name (see lib/invoiceNumber.js) the first
  // time an invoice is generated for this customer, then held fixed so
  // invoice numbers stay stable even if those names are edited later. Not
  // unique by design — the client's naming convention can collide between
  // customers (invoiceNo itself stays unique regardless).
  invoicePrefix  String?
  nextInvoiceSeq Int     @default(1)

  orders   Order[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id             Int      @id @default(autoincrement())
  customerId     Int
  customer       Customer @relation(fields: [customerId], references: [id])
  name           String
  date           DateTime @db.Date
  price          Float
  currency       String
  designerId     Int
  designer       Employee @relation("OrderDesigner", fields: [designerId], references: [id])
  productionCost Float    @default(0)
  productionCostCurrency String @default("PKR")
  commissionRate Float    @default(10)
  status         String   @default("Pending")

  commissionPaid Boolean @default(false)
  productionPaid Boolean @default(false)

  commissionPayslipId Int?
  commissionPayslip   Payslip? @relation("CommissionPayslip", fields: [commissionPayslipId], references: [id])
  productionPayslipId Int?
  productionPayslip   Payslip? @relation("ProductionPayslip", fields: [productionPayslipId], references: [id])

  invoiceId Int?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  comments OrderComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderComment {
  id      Int      @id @default(autoincrement())
  orderId Int
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author  String
  date    DateTime @db.Date
  text    String

  createdAt DateTime @default(now())
}

model Invoice {
  id            Int      @id @default(autoincrement())
  customerId    Int
  customer      Customer @relation(fields: [customerId], references: [id])
  invoiceNo     String   @unique
  version       Int      @default(1)
  total         Float
  currency      String
  generatedDate DateTime @db.Date
  approvedDate  DateTime @db.Date
  paymentStatus String   @default("Pending")

  orders Order[]

  createdAt DateTime @default(now())
}

model Payslip {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  employee     Employee @relation(fields: [employeeId], references: [id])
  slipNo       String   @unique
  total        Float
  currency     String
  baseSalary   Float
  commission   Float
  bonusTotal   Float    @default(0)
  approvedDate DateTime @db.Date
  paymentStatus String  @default("Pending")

  commissionOrders Order[] @relation("CommissionPayslip")
  productionOrders Order[] @relation("ProductionPayslip")
  bonuses          PayslipBonus[]

  createdAt DateTime @default(now())
}

// One-off extra line items added to a slip at approval time (e.g. "Eid
// Bonus", "Performance Bonus") — a slip can have any number of these, each
// with its own label and amount, summing to Payslip.bonusTotal.
model PayslipBonus {
  id        Int     @id @default(autoincrement())
  payslipId Int
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  label     String
  amount    Float
}

model PasswordResetRequest {
  id          Int      @id @default(autoincrement())
  email       String
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id])
  requestedAt DateTime @default(now())
}

// Admin-facing activity feed — e.g. a salesperson adding a customer or
// requesting a password reset. Read status is tracked so the topbar bell
// can show an unread count.
model Notification {
  id         Int       @id @default(autoincrement())
  type       String
  message    String
  link       String?
  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())
}
