DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
COOKIE_SECURE=false
EXCHANGE_RATE_API_KEY="get-a-free-key-at-exchangerate-api.com"
# One-time recovery code for resetting the admin account's password when
# locked out — fallback for when SMTP below isn't configured, or breaks.
# Whoever controls this value controls admin recovery. Generate a long
# random string and keep it out of version control.
ADMIN_RECOVERY_CODE="change-me-to-a-long-random-string"

# Hostinger SMTP, for the admin "forgot password" reset email. In hPanel:
# Emails > your address > Connect Apps & Devices > Manual Configuration —
# gives you the exact host/port/username for that mailbox. SMTP_PASS is
# that mailbox's own password (not your Hostinger account password).
# Typical Hostinger values: host smtp.hostinger.com, port 465 (SSL).
# Leave these unset to disable email sending (falls back to
# ADMIN_RECOVERY_CODE above) — e.g. for local development.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="that-mailbox-password"
SMTP_FROM="ElegantsDesign <noreply@theelegantsdesign.com>"
